# Copy to .env and fill in. Docker Compose overrides DATABASE_URL / REDIS_URL for containers;
# the values below are for running the backend directly on your machine.
DATABASE_URL=postgresql+asyncpg://tracker:tracker@localhost:55432/tracker
REDIS_URL=redis://localhost:56379/0

# services = the Docker setup (live Upstox stream). cron = free web hosting: an external
# scheduler POSTs /api/cron/poll every minute with header X-Cron-Secret (see README).
RUN_MODE=services
CRON_SECRET=

# --- Accounts ------------------------------------------------------------------------------
# Users are stored in the database and anyone can register on the sign-in page.
# ADMIN_* only creates the first admin account when the database is set up (existing
# watchlists and history are given to it). After that, change passwords in the app, or with:
#   cd backend && python -m app.cli set-password admin
# Generate a hash with:  cd backend && python -m app.cli hash-password   (keep the single quotes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Plain-text fallback for local dev only; ignored when ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=admin
# The admin's email, for "Forgot password"
ADMIN_EMAIL=
# false = only existing users can sign in
REGISTRATION_ENABLED=true
# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please
# Set true when served over HTTPS
COOKIE_SECURE=false

# --- Email (password-reset links) ----------------------------------------------------------
# console = don't send; the reset link is printed in the api log (local development).
# brevo   = send through Brevo's free HTTP API (300 emails/day). See README → Email setup.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Tracker
# Public address used in reset links, e.g. https://tracker.onrender.com (default: request URL)
APP_BASE_URL=

# --- Market data ---------------------------------------------------------------------------
# simulated = random-walk prices + POST /api/dev/ticks injection (no Upstox account needed)
# upstox    = live Upstox V3 feed using the Analytics Token
MARKET_DATA_PROVIDER=simulated
# Upstox Developer Apps -> Analytics tab -> Generate Token (read-only, valid 1 year)
UPSTOX_ANALYTICS_TOKEN=
# Expiry date shown when you generate the token (YYYY-MM-DD); used for renewal reminders
UPSTOX_TOKEN_EXPIRES_ON=
# Feed only connects inside this IST window on NSE trading days
MARKET_OPEN=09:00
MARKET_CLOSE=15:40
ENFORCE_MARKET_HOURS=true
INSTRUMENTS_SYNC_ON_START=true
MAX_SUBSCRIPTIONS=2000

# Simulated provider tuning. Set SIMULATED_RANDOM_WALK=false for fully deterministic testing.
SIMULATED_RANDOM_WALK=true
SIMULATED_VOLATILITY_PCT=0.05

# --- Telegram ------------------------------------------------------------------------------
# Create a bot with @BotFather. Each user connects their own chat in Settings → Telegram alerts.
TELEGRAM_BOT_TOKEN=
# Optional: pre-connects the admin account when the database is first set up
TELEGRAM_CHAT_ID=
# How the bot receives commands/button taps: auto (webhook on free hosting with an https
# APP_BASE_URL, polling in Docker), webhook, polling, or off.
TELEGRAM_MODE=auto

# --- WhatsApp (Meta WhatsApp Cloud API) — admin's alerts only -------------------------------
# Permanent System User token with whatsapp_business_messaging permission
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your number with country code, e.g. 919876543210
WHATSAPP_TO=
WHATSAPP_TEMPLATE=stock_price_alert
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v21.0
