# Copy to .env and fill in. Docker Compose overrides DATABASE_URL / REDIS_URL for containers;
# the values below are for running the backend directly on your machine.
DATABASE_URL=postgresql+asyncpg://tracker:tracker@localhost:55432/tracker
REDIS_URL=redis://localhost:56379/0

# services = the Docker setup (live Upstox stream). cron = free web hosting: an external
# scheduler POSTs /api/cron/poll every minute with header X-Cron-Secret (see README).
RUN_MODE=services
CRON_SECRET=

# --- Dashboard login (single user) -------------------------------------------------------
# Generate with:  cd backend && python -m app.cli hash-password   (keep the single quotes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Plain-text fallback for local dev only; ignored when ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=admin
# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please
# Set true when served over HTTPS
COOKIE_SECURE=false

# --- Market data ---------------------------------------------------------------------------
# simulated = random-walk prices + POST /api/dev/ticks injection (no Upstox account needed)
# upstox    = live Upstox V3 feed using the Analytics Token
MARKET_DATA_PROVIDER=simulated
# Upstox Developer Apps -> Analytics tab -> Generate Token (read-only, valid 1 year)
UPSTOX_ANALYTICS_TOKEN=
# Expiry date shown when you generate the token (YYYY-MM-DD); used for renewal reminders
UPSTOX_TOKEN_EXPIRES_ON=
# Feed only connects inside this IST window on NSE trading days
MARKET_OPEN=09:00
MARKET_CLOSE=15:40
ENFORCE_MARKET_HOURS=true
INSTRUMENTS_SYNC_ON_START=true
MAX_SUBSCRIPTIONS=2000

# Simulated provider tuning. Set SIMULATED_RANDOM_WALK=false for fully deterministic testing.
SIMULATED_RANDOM_WALK=true
SIMULATED_VOLATILITY_PCT=0.05

# --- Telegram ------------------------------------------------------------------------------
# Create a bot with @BotFather, send /start to it, then:  python -m app.notify.telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp (Meta WhatsApp Cloud API) ----------------------------------------------------
# Permanent System User token with whatsapp_business_messaging permission
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your number with country code, e.g. 919876543210
WHATSAPP_TO=
WHATSAPP_TEMPLATE=stock_price_alert
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v21.0
